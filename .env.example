# ── 사내 AI ────────────────────────────────────────────────────────────
# 사내 AI 게이트웨이 주소. app/llm/corp.py 의 엔드포인트 경로와 합쳐진다.
CORP_AI_BASE_URL=https://ai-gateway.your-company.internal/v1
CORP_AI_API_KEY=
CORP_AI_MODEL=

# 사내 AI가 네이티브 tool/function calling을 지원하면 true.
# 모르면 false로 두세요 — ReAct 폴백이 어떤 모델에서도 동작합니다.
CORP_AI_NATIVE_TOOLS=false
CORP_AI_TIMEOUT=120
CORP_AI_MAX_RETRIES=3

# ── 저장소 ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://genteam:genteam@localhost:5432/genteam
# 1이면 DB 없이 인메모리로 뜬다 (개발/데모용, 재시작하면 사라짐)
USE_MEMORY_STORE=0

# ── 폭주 제어 ──────────────────────────────────────────────────────────
# 에이전트→에이전트 홉 최대 횟수. 넘으면 mention_agent 도구가 사라진다.
MAX_MENTION_DEPTH=4
# 사람의 한 마디에서 파생된 연쇄 전체의 토큰 상한
MAX_TRACE_TOKENS=120000
# 그 연쇄에서 허용할 에이전트 실행 횟수 상한 (최후의 백스톱)
MAX_TRACE_RUNS=20
# 한 턴 안에서 허용할 툴 루프 최대 횟수
MAX_AGENT_STEPS=8
MAX_CONCURRENCY=8
