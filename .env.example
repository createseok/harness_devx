# ── LLM 백엔드 선택 (여기 한 줄이 교체 지점) ───────────────────────────
# claude_cli : claude -p 헤드리스. API 키 불필요, 기존 Claude 구독 사용 (지금)
# anthropic  : Anthropic API. 네이티브 tool calling, 더 빠름
# corp       : 사내 AI (나중)
# mock       : 테스트/데모
LLM_PROVIDER=claude_cli

# ── claude -p ─────────────────────────────────────────────────────────
# 설치: npm install -g @anthropic-ai/claude-code
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=opus
CLAUDE_CLI_TIMEOUT=180
# 0이면 미설정. 폭주 시 최후 방어선으로 걸어두면 좋다
CLAUDE_CLI_MAX_BUDGET_USD=0
CLAUDE_CLI_EXTRA_ARGS=
# Claude Code 내장 툴 (읽기 전용만). Bash/Write/Edit 은 넣어도 코드에서 걸러진다.
# WebFetch 를 일부러 뺐다 — 우리 fetch_url 이 SSRF 가드·툴로그를 갖고 있고
# provider 를 갈아타도 남는데, 내장 WebFetch 를 열면 그쪽을 쓰면서 우회한다.
CLAUDE_CLI_TOOLS=WebSearch
# 검색→읽기→답변까지 갈 수 있을 만큼. 1이면 검색 결과를 받아보지도 못한다.
CLAUDE_CLI_MAX_TURNS=6

# ── Anthropic API ─────────────────────────────────────────────────────
# 비워두면 SDK가 ANTHROPIC_API_KEY → `ant auth login` 프로필 순으로 찾는다
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# ── 사내 AI (나중에 LLM_PROVIDER=corp 로 전환) ─────────────────────────
# 사내 AI 게이트웨이 주소. app/llm/corp.py 의 엔드포인트 경로와 합쳐진다.
CORP_AI_BASE_URL=https://ai-gateway.your-company.internal/v1
CORP_AI_API_KEY=
CORP_AI_MODEL=

# 사내 AI가 네이티브 tool/function calling을 지원하면 true.
# 모르면 false로 두세요 — ReAct 폴백이 어떤 모델에서도 동작합니다.
CORP_AI_NATIVE_TOOLS=false
CORP_AI_TIMEOUT=120
CORP_AI_MAX_RETRIES=3

# ── 저장소 ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://genteam:genteam@localhost:5432/genteam
# 1이면 DB 없이 인메모리로 뜬다 (개발/데모용, 재시작하면 사라짐)
USE_MEMORY_STORE=0

# ── 폭주 제어 ──────────────────────────────────────────────────────────
# 에이전트→에이전트 홉 최대 횟수. 넘으면 mention_agent 도구가 사라진다.
MAX_MENTION_DEPTH=3
# 사람의 한 마디에서 파생된 연쇄 전체의 토큰 상한
# 실측: 24턴에 89,977토큰. 8~10턴이면 충분하므로 60k 로 잡는다
MAX_TRACE_TOKENS=60000
# 그 연쇄에서 허용할 에이전트 실행 횟수 상한 (최후의 백스톱)
MAX_TRACE_RUNS=10
# 한 턴 안에서 허용할 툴 루프 최대 횟수
MAX_AGENT_STEPS=6
MAX_CONCURRENCY=8
